# -*- coding: utf-8 -*-
from typing import Any, Dict, List

from .logresponse import LogResponse

class CreateLogStoreResponse(LogResponse):
    def __init__(self, header: Dict[str, Any], resp: Any = ...) -> None: ...
    def log_print(self) -> None: ...

class DeleteLogStoreResponse(LogResponse):
    def __init__(self, header: Dict[str, Any], resp: Any = ...) -> None: ...
    def log_print(self) -> None: ...

class GetLogStoreResponse(LogResponse):
    enable_modify: bool
    def __init__(self, resp: Dict[str, Any], header: Dict[str, Any]) -> None: ...
    def get_shard_count(self) -> int: ...
    def get_ttl(self) -> int: ...
    def get_hot_ttl(self) -> int: ...
    def get_enable_tracking(self) -> bool: ...
    def get_enable_modify(self) -> bool: ...
    def get_encrypt_conf(self) -> Any: ...
    def log_print(self) -> None: ...

class UpdateLogStoreResponse(LogResponse):
    def __init__(self, header: Dict[str, Any], resp: Any = ...) -> None: ...
    def log_print(self) -> None: ...

class ListLogStoreResponse(LogResponse):
    def __init__(self, resp: Dict[str, Any], header: Dict[str, Any]) -> None: ...
    def get_logstores(self) -> List[str]: ...
    def get_count(self) -> int: ...
    def get_logstores_count(self) -> int: ...
    def get_logstores_total(self) -> int: ...
    def get_total(self) -> int: ...
    def log_print(self) -> None: ...
    def merge(self, response: "ListLogStoreResponse") -> "ListLogStoreResponse": ...
    @property
    def total(self) -> int: ...
    @property
    def logstores(self) -> List[str]: ...
